@model IEnumerable<Quiz>
@{
    ViewData["Title"] = "Manage Quizzes";
}
@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Manage Quizzes</h3>
    <a asp-action="Create" class="btn btn-primary">+ Create Quiz</a>
</div>

<input id="searchBox" class="form-control mb-3" placeholder="Search by title..." />

<div id="quizTable">
    <partial name="_QuizTable" model="Model" />
</div>

@section Scripts {
    <script src="~/js/quizzes.js" asp-append-version="true"></script>
}
@section Styles {
    <style>
        .status-badge {
            font-size: 0.85rem;
        }
    </style>
}