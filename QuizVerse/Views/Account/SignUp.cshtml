
@{
}
<div class="container">
    <h1 class="mb-4">Login</h1>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-4">
                <h5 class="card-title text-center mb-3">Login</h5>

                <form>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" placeholder="abc@email.com" />
                    </div>
                    <div class="mb-3">
                        <label for="name" class="form-label">Name</label>
                        <input type="text" class="form-control" id="name" placeholder="Imran Khan" />
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" class="form-control" id="password"  />
                    </div>
                    <div class="mb-3">
                        <label for="checkPassword" class="form-check-label">Confirm Password</label>
                        <input type="password" class="form-control" id="checkPassword" name="checkPassword" />
                    </div>
                    <button type="submit" class="btn btn-outline-primary w-100">SignUp</button>
                </form>
                <p class="text-success-emphasis text-center">Already have an Account? <a href="./Login" class="link-info">Login</a></p>
            </div>
        </div>
    </div>
</div>
