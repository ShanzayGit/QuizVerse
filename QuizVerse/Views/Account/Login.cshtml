@{
}
<div class="container">
    <h1 class="mb-4">Login</h1>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-4">
                <h5 class="card-title text-center mb-3">Login</h5>

                <form>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" placeholder="abc@email.com" />
                    </div>
                    <div class="mb-3">
                        <label for="name" class="form-label">Name</label>
                        <input type="text" class="form-control" id="name" placeholder="Imran Khan" />
                    </div>
                    <div class="mb-3">
                        <label for="remember" class="form-check-label">Remember me</label>
                        <input type="checkbox" class="form-check-input" id="remember" name="remember" />
                    </div>
                    <button type="submit" class="btn btn-outline-primary w-100">Login</button>
                </form>
                <p class="text-danger-emphasis text-center">Don't have an Account? <a href="./SignUp" class="link-info">SignUp</a></p>
            </div>
        </div>
    </div>
</div>

@section AuthButtons {
    <div class="d-flex gap-2">
        <a class="btn btn-primary" href="./SignUp">Sign Up</a>
    </div>
}