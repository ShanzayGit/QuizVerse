@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuizVerse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    <div class="container-fluid">
        <div class="row min-vh-100">

            <nav class="col-md-3 col-lg-2 bg-primary-subtle text-dark p-3">
                <h4 class="mb-4">QuizVerse</h4>
                <ul class="nav nav-pills flex-column gap-1">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Admin" asp-action="Dashboard">
                            <i class="bi bi-speedometer2 me-2"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#">
                            <i class="bi bi-journal-text me-2"></i>Manage Quizzes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#">
                            <i class="bi bi-bar-chart me-2"></i>All Attempts
                        </a>
                    </li>
                    <li class="nav-item mt-4">
                        <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-left me-2"></i>Logout
                        </a>
                    </li>
                </ul>
            </nav>

            <main class="col-md-9 col-lg-10 p-4">
                <div class="container m-2 p-2">
                    <h4 class="lead fw-bolder fs-2">Admin Dashboard</h4>
                    <div class="row p-2 m-2">

                        <div class="col-12 col-md-6 ">
                            <div class="card bg-secondary-subtle">
                                <div class="card-body">
                                    <p class="card-title text-secondary">Total Quizzes </p>
                                    <p class="card-text">38</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 ">
                            <div class="card bg-secondary-subtle">
                                <div class="card-body">
                                    <p class="card-title text-secondary">Published</p>
                                    <p class="card-text">8</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row p-2 m-2">

                        <div class="col-12 col-md-6 ">
                            <div class="card bg-secondary-subtle">
                                <div class="card-body">
                                    <p class="card-title text-secondary">Total Users</p>
                                    <p class="card-text">89</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 ">
                            <div class="card bg-secondary-subtle">
                                <div class="card-body">
                                    <p class="card-title text-secondary">Attempts</p>
                                    <p class="card-text">345</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                        <h4 class="mb-0">Recent Quizzes</h4>
                        <a href="#" class="btn btn-primary">
                            <i class="bi bi-plus-lg"></i> Create New Quiz
                        </a>
                    </div>

                    <div class="card shadow-sm">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Title</th>
                                        <th>Questions</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>1</td>
                                        <td>C# Basics</td>
                                        <td>10</td>
                                        <td><span class="badge bg-success">Published</span></td>
                                        <td class="text-end">
                                            <a href="#" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
                                            <a href="#" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>SQL Intro</td>
                                        <td>8</td>
                                        <td><span class="badge bg-secondary">Draft</span></td>
                                        <td class="text-end">
                                            <a href="#" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
                                            <a href="#" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>3</td>
                                        <td>HTML Quiz</td>
                                        <td>12</td>
                                        <td><span class="badge bg-success">Published</span></td>
                                        <td class="text-end">
                                            <a href="#" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
                                            <a href="#" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>

        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>