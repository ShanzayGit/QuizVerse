@{
    ViewData["Title"] = "Contact Us";
}
<h1>@ViewData["Title"]</h1>

<div class="container p-4 m-4 text-center">
    <div class="container">
        <h1 class="mb-4">Contact Us</h1>
        <p class="text-center">If you have any complaint or feedback contact us.</p>

        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card p-4">
                    <h5 class="card-title text-center mb-3">Contact Us</h5>

                    <form>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" placeholder="abc@email.com" />
                        </div>
                        <div class="mb-3">
                            <label for="name" class="form-label">Name</label>
                            <input type="text" class="form-control" id="name" placeholder="Imran Khan" />
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label">Message</label>
                            <textarea class="form-control" id="message" rows="4" placeholder="Type your message here"></textarea>
                        </div>
                        <button type="submit" class="btn btn-outline-primary w-50">Send</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>