@model List<Quiz>
@{
    ViewData["Title"] = "Home";
    bool loggedIn = User.Identity != null && User.Identity.IsAuthenticated;
}

@* Hero  *@
<section class="bg-light rounded-3 text-center py-5 px-3 mb-5">
    <h1 class="display-5 fw-bold">Test your knowledge with QuizVerse</h1>
    <p class="lead text-muted mb-1">Attempt quizzes, get instant scores, and track your progress.</p>
    <p class="text-primary fw-semibold mb-4">@ViewBag.QuizCount quizzes available right now</p>

    @if (loggedIn)
    {
        <a class="btn btn-primary btn-lg"
           asp-controller="@(User.IsInRole("Admin") ? "Admin" : "User")"
           asp-action="Dashboard">Go to Dashboard</a>
    }
    else
    {
        <a class="btn btn-primary btn-lg me-2" asp-controller="Account" asp-action="Signup">Get Started</a>
        <a class="btn btn-outline-primary btn-lg" asp-controller="Account" asp-action="Login">Login</a>
    }
</section>

 @* Features *@
<section class="mb-5">
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm p-3">
                <div class="fs-1 text-primary"><i class="bi bi-pencil-square"></i></div>
                <h5 class="mt-2">Take Quizzes</h5>
                <p class="text-muted mb-0">Choose from quizzes created by the admin and attempt them online.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm p-3">
                <div class="fs-1 text-primary"><i class="bi bi-lightning-charge"></i></div>
                <h5 class="mt-2">Instant Results</h5>
                <p class="text-muted mb-0">Get your score as soon as you submit your answers.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm p-3">
                <div class="fs-1 text-primary"><i class="bi bi-graph-up"></i></div>
                <h5 class="mt-2">Track Attempts</h5>
                <p class="text-muted mb-0">Review your past attempts and see how you improve.</p>
            </div>
        </div>
    </div>
</section>

 @* Featured quizzes (from the database)  *@
<section class="mb-5">
    <h3 class="text-center mb-4">Latest Quizzes</h3>

    @if (Model.Any())
    {
        <div class="row g-3">
            @foreach (var quiz in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@quiz.Title</h5>
                            <p class="card-text text-muted">@quiz.Description</p>
                            <span class="badge bg-primary me-1">@quiz.QuestionCount Questions</span>
                            <span class="badge bg-secondary">@quiz.TimeLimitMinutes min</span>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3">
                            @if (loggedIn)
                            {
                                <a class="btn btn-outline-primary w-100"
                                   asp-controller="@(User.IsInRole("Admin") ? "Admin" : "User")"
                                   asp-action="Dashboard">Open Dashboard</a>
                            }
                            else
                            {
                                <a class="btn btn-outline-primary w-100" asp-controller="Account" asp-action="Login">Login to Start</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-center text-muted">No quizzes have been published yet. Check back soon.</p>
    }
</section>

 @* How it works  *@
<section class="mb-5">
    <h3 class="text-center mb-4">How it works</h3>
    <div class="row text-center g-3">
        <div class="col-md-4">
            <div class="display-6 text-primary">1</div>
            <p class="fw-semibold mb-0">Sign up</p>
            <p class="text-muted">Create a free account.</p>
        </div>
        <div class="col-md-4">
            <div class="display-6 text-primary">2</div>
            <p class="fw-semibold mb-0">Choose a quiz</p>
            <p class="text-muted">Pick any published quiz.</p>
        </div>
        <div class="col-md-4">
            <div class="display-6 text-primary">3</div>
            <p class="fw-semibold mb-0">See your score</p>
            <p class="text-muted">Results appear right after submitting.</p>
        </div>
    </div>
</section>

@* // Call to action (guests only) *@
@if (!loggedIn)
{
    <section class="bg-primary text-white rounded-3 text-center py-4 mb-4">
        <h4 class="mb-3">Ready to test yourself?</h4>
        <a class="btn btn-light" asp-controller="Account" asp-action="Signup">Sign Up Now</a>
    </section>
}