@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuizVerse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    <div class="container-fluid">
        <div class="row min-vh-100">

            <nav class="col-md-3 col-lg-2 bg-primary-subtle  text-dark p-3">
                <h4 class="mb-4">QuizVerse</h4>
                <ul class="nav nav-pills flex-column gap-1">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="User" asp-action="Dashboard">
                            <i class="bi bi-speedometer2 me-2"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#">
                            <i class="bi bi-journal-text me-2"></i>Quizzes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#">
                            <i class="bi bi-bar-chart me-2"></i>My Attempts
                        </a>
                    </li>
                    <li class="nav-item mt-4">
                        <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-left me-2"></i>Logout
                        </a>
                    </li>
                </ul>
            </nav>

            <main class="col-md-9 col-lg-10 p-4">
                <div class="container m-2 p-2">
                    <h4 class="lead fw-bolder fs-2">Welcome back, User</h4>
                    <div class="row p-2 m-2">

                        <div class="col-12 col-md-6 ">
                            <div class="card bg-secondary-subtle">
                                <div class="card-body">
                                    <p class="card-title text-secondary">Quizzes Taken</p>
                                    <p class="card-text">8</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 ">
                            <div class="card bg-secondary-subtle">
                                <div class="card-body">
                                    <p class="card-title text-secondary">Average</p>
                                    <p class="card-text">89%</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row p-2 m-2">
                        <div class="col-12 card bg-secondary-subtle">
                            <div class="card-body">
                                <p class="card-title text-secondary">Best Score</p>
                                <p class="card-text">95%</p>
                            </div>
                        </div>
                    </div>
                    <h4 class="mt-4 mb-3">Available Quizzes</h4>

                    <div class="row g-3">

                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title">C# Basics</h5>
                                    <p class="card-text text-muted">Test your knowledge of C# fundamentals.</p>
                                    <span class="badge bg-primary me-1"><i class="bi bi-question-circle"></i> 10 Questions</span>
                                    <span class="badge bg-secondary"><i class="bi bi-clock"></i> 15 min</span>
                                </div>
                                <div class="card-footer bg-white border-0 pb-3">
                                    <a href="#" class="btn btn-primary w-100">Start Quiz</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title">HTML Quiz</h5>
                                    <p class="card-text text-muted">Check your HTML and Bootstrap skills.</p>
                                    <span class="badge bg-primary me-1"><i class="bi bi-question-circle"></i> 12 Questions</span>
                                    <span class="badge bg-secondary"><i class="bi bi-clock"></i> 20 min</span>
                                </div>
                                <div class="card-footer bg-white border-0 pb-3">
                                    <a href="#" class="btn btn-primary w-100">Start Quiz</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title">SQL Intro</h5>
                                    <p class="card-text text-muted">Basic queries, joins, and filtering.</p>
                                    <span class="badge bg-primary me-1"><i class="bi bi-question-circle"></i> 8 Questions</span>
                                    <span class="badge bg-secondary"><i class="bi bi-clock"></i> 10 min</span>
                                </div>
                                <div class="card-footer bg-white border-0 pb-3">
                                    <a href="#" class="btn btn-primary w-100">Start Quiz</a>
                                </div>
                            </div>
                        </div>

                    </div>
                    <table class="table table-striped m-2 ">
                        <thead class="table-dark">
                            <tr>
                                <th>Quiz</th>
                                <th>Score</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>C# Basics</td>
                                <td>9/10</td>
                                <td>03/Jan/2026</td>
                            </tr>
                            <tr>
                                <td>SQL Intro</td>
                                <td>8/8</td>
                                <td>13/Feb/2026</td>
                            </tr>
                            <tr>
                                <td>C# Advanced</td>
                                <td>2/10</td>
                                <td>03/Mar/2026</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </main>

        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>